    <!-- Bloco de Texto Desordenado -->
    <div class="text-block text-1">
      <h1>404 PAGE NOT FOUND</h1>
      <p>{erros[0]}</p>
    </div>

    <div class="text-block text-2">
      <p>{erros[2]}</p>
      <a href="/pt/" class="terminal-btn">[ ESCAPE TO /PT/ ]</a>
    </div>

    <div class="text-block text-3">
      <p>{erros[3]}</p>
      <a href="/en/" class="terminal-btn">[ ESCAPE TO /EN/ ]</a>
    </div>

  </div>
<div class="terminal-wrapper">
  <div class="terminal-header">
    <span class="status-dot"></span>
    <span class="terminal-title">bash - 404 NOT FOUND</span>
  </div>

  <div id="terminal-output" class="terminal-output">
    <div class="line">404: Page not found. Terminal access granted.</div>
    <div class="line">Type <span class="highlight">'help'</span> for a list of available commands.</div>
  </div>

  <div class="input-line">
    <span class="prompt">visitor@bagi-sh:~$</span>
    <input 
      type="text" 
      id="cli-input" 
      class="cli-input" 
      autocomplete="off" 
      autofocus 
      spellcheck="false"
    />
  </div>
</div>

<script>
  import { commands, executeCommand } from '../lib/cli-engine.ts';

  const inputEl = document.getElementById('cli-input') as HTMLInputElement | null;
  const outputEl = document.getElementById('terminal-output') as HTMLDivElement | null;

  // Estado do Histórico de Comandos
  const history: string[] = [];
  let historyIndex = -1;

  if (inputEl && outputEl) {
    // Manter foco no input se o usuário clicar no terminal
    document.addEventListener('click', () => inputEl.focus());

    inputEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') {
        const rawValue = inputEl.value;
        
        if (rawValue.trim() !== '') {
          history.push(rawValue);
          historyIndex = history.length;
        }

        // Renderizar a linha digitada pelo usuário no buffer do terminal
        appendLine(`visitor@bagi-sh:~$ ${rawValue}`, 'prompt-echo');

        // Processar execução através do módulo TS
        const result = executeCommand(rawValue, commands);

        if (result.isClearCommand) {
          outputEl.innerHTML = '';
        } else if (result.output) {
          appendLine(result.output, 'command-response');
        }

        inputEl.value = '';
        scrollToBottom();
      } 
      else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (history.length > 0 && historyIndex > 0) {
          historyIndex--;
          inputEl.value = history[historyIndex];
        }
      } 
      else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < history.length - 1) {
          historyIndex++;
          inputEl.value = history[historyIndex];
        } else {
          historyIndex = history.length;
          inputEl.value = '';
        }
      }
    });
  }

  function appendLine(text: string, className: string): void {
    if (!outputEl) return;
    const line = document.createElement('div');
    line.className = `line ${className}`;
    line.textContent = text;
    outputEl.appendChild(line);
  }

  function scrollToBottom(): void {
    if (!outputEl) return;
    outputEl.scrollTop = outputEl.scrollHeight;
  }
</script>

</LayoutGlobal>

<style>
  .chaos-wrapper {
    position: relative;
    width: 100%;
    min-height: 80vh;
    overflow: hidden;
    font-family: var(--font-mono, monospace);
    color: var(--fg-color, #ccc);
  }

  .ascii-art {
    position: absolute;
    font-family: var(--font-mono, monospace);
    line-height: 1.1;
    color: var(--accent-color, #00ff66);
    user-select: none;
    white-space: pre;
  }

  .ascii-main {
    top: 5%;
    left: 20%;
    transform: rotate(-4deg);
    font-size: 1.2rem;
    border: 1px dashed var(--accent-color, #00ff66);
    padding: 1rem;
    background: #000;
  }

  .ascii-float-1 {
    top: 55%;
    left: 2%;
    transform: rotate(7deg);
    color: #ff5555;
  }

  .ascii-float-2 {
    top: 12%;
    right: 5%;
    transform: rotate(-12deg);
    color: #ffff55;
  }

  /* Caixas de GIFs Espalhadas */
  .gif-box {
    position: absolute;
    border: 1px solid var(--border-color, #333);
    background-color: #050505;
    padding: 0.3rem;
  }

  .gif-box img {
    display: block;
    max-width: 180px;
    height: auto;
    filter: grayscale(80%);
  }

  .gif-box:hover img {
    filter: grayscale(0%);
  }

  .gif-tag {
    display: block;
    font-size: 0.7rem;
    color: var(--accent-color, #00ff66);
    margin-top: 0.2rem;
  }

  .gif-1 {
    top: 35%;
    right: 15%;
    transform: rotate(8deg);
  }

  .gif-2 {
    top: 60%;
    left: 35%;
    transform: rotate(-5deg);
  }

  .gif-3 {
    top: 2%;
    right: 38%;
    transform: rotate(15deg);
  }

  /* Blocos de Texto Tortos */
  .text-block {
    position: absolute;
    background: #0a0a0a;
    border: 1px solid var(--border-color, #333);
    padding: 0.8rem;
  }

  .text-1 {
    top: 38%;
    left: 5%;
    transform: rotate(-3deg);
  }

  .text-1 h1 {
    font-size: 1.4rem;
    color: #ff5555;
    margin: 0;
  }

  .text-2 {
    bottom: 5%;
    left: 15%;
    transform: rotate(4deg);
  }

  .text-3 {
    bottom: 10%;
    right: 8%;
    transform: rotate(-6deg);
  }

  /* Botões de Fuga */
  .terminal-btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.3rem 0.6rem;
    background-color: #111;
    color: var(--accent-color, #00ff66);
    border: 1px solid var(--accent-color, #00ff66);
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.1s linear;
  }

  .terminal-btn:hover {
    background-color: var(--accent-color, #00ff66);
    color: #000;
  }

  /* Ajuste para telas menores (Dispositivos móveis) */
  @media (max-width: 600px) {
    .chaos-wrapper {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      position: static;
      padding: 1rem;
    }

    .ascii-art, .gif-box, .text-block {
      position: static;
      transform: none !important;
      max-width: 100%;
    }

    .gif-box img {
      max-width: 100%;
    }
  }

.terminal-wrapper {
    background-color: #050505;
    border: 1px solid var(--border-color, #222);
    font-family: var(--font-mono, monospace);
    padding: 1rem;
    max-width: 700px;
    margin: 2rem auto;
    color: #ccc;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px dashed #222;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #ff5555;
    border-radius: 50%;
  }

  .terminal-title {
    font-size: 0.8rem;
    color: #666;
  }

  .terminal-output {
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .line {
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .highlight {
    color: var(--accent-color, #00ff66);
  }

  .prompt-echo {
    color: #888;
  }

  .command-response {
    color: #eee;
  }

  .input-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prompt {
    font-size: 0.85rem;
    color: var(--accent-color, #00ff66);
    white-space: nowrap;
  }

  .cli-input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: inherit;
    font-size: 0.85rem;
    width: 100%;
  }
</style>
