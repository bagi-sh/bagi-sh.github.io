---
import LayoutGlobal from '../../../layouts/LayoutGlobal.astro';
import { projects, type ProjectEntry } from '../../../data/projects';
import { getProjectDocs } from '../../../lib/github-docs';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { project: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const projectDocs = project.docs ? await getProjectDocs(project) : null;
const switchedPath = `/pt/projects/${project.slug}/`;
---

<LayoutGlobal
  title={`${project.title} | Projects`}
  description={project.description}
  lang="en"
  switchedPath={switchedPath}
>
  <div class="project-page-container">
    <header class="project-hero">
      <div class="project-meta-top">
        <span class="category-tag">[{project.category.toUpperCase()}]</span>
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link">
          <img src="/icons/github.svg" alt="GitHub" class="inline-icon" />
          <span>GitHub Repository &#8599;</span>
        </a>
      </div>

      <h1 class="project-title">{project.title}</h1>
      <p class="project-tagline">{project.description}</p>
    </header>

    {projectDocs && projectDocs.readmeHtml ? (
      <section class="project-readme-section">
        <div class="section-badge">:: README.md</div>
        <article class="doc-body" set:html={projectDocs.readmeHtml} />
      </section>
    ) : (
      <div class="no-readme">No README available for this project.</div>
    )}

    {project.docs && (
      <div class="project-actions">
        <a href={`/en/doc/${project.slug}/`} class="btn-primary-docs">
          <span class="btn-icon">&rarr;</span>
          <span class="btn-text">Read The Documentation ({project.title} Book)</span>
        </a>
      </div>
    )}
  </div>
</LayoutGlobal>

<style>
  .project-page-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 0 3rem 0;
  }

  .project-hero {
    border: 1px solid var(--border-color);
    background-color: #080808;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .project-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .category-tag {
    color: var(--accent-color);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #888;
    transition: color 0.15s ease;
  }

  .repo-link:hover {
    color: var(--accent-color);
  }

  .inline-icon {
    width: 14px;
    height: 14px;
  }

  .project-title {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .project-tagline {
    font-size: 1.05rem;
    color: #aaa;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .project-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color);
  }

  .btn-primary-docs {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--accent-color);
    color: #050505;
    padding: 0.65rem 1.25rem;
    font-weight: bold;
    font-size: 0.95rem;
    border-radius: 2px;
    transition: all 0.15s ease;
  }

  .btn-primary-docs:hover {
    background-color: #fff;
    color: #050505;
    transform: translateX(3px);
  }

  .project-readme-section {
    border: 1px solid var(--border-color);
    background-color: #070707;
    padding: 2rem;
  }

  .section-badge {
    font-size: 0.8rem;
    color: var(--accent-color);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--border-color);
    font-family: var(--font-mono);
  }

  .no-readme {
    color: #666;
    font-style: italic;
    padding: 2rem;
    text-align: center;
  }

  /* ── doc-body: README markdown styles (mirrors .doc-article in docs page) ── */

  :global(.doc-body p) {
    margin-bottom: 1.1rem;
    line-height: 1.7;
    color: #ccc;
  }

  :global(.doc-body h1) {
    font-size: 1.85rem;
    color: #fff;
    margin-bottom: 1rem;
    border-bottom: 1px solid #222;
    padding-bottom: 0.5rem;
  }

  :global(.doc-body h2) {
    font-size: 1.35rem;
    color: #eee;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px dashed #222;
    padding-bottom: 0.35rem;
  }

  :global(.doc-body h3) {
    font-size: 1.1rem;
    color: #ccc;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  :global(.doc-body hr) {
    border: none;
    border-top: 1px dashed var(--border-color);
    margin: 2rem 0;
  }

  :global(.doc-body blockquote) {
    border-left: 3px solid var(--accent-color);
    background-color: rgba(0, 255, 102, 0.04);
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    color: #bbb;
  }

  :global(.doc-body code:not(pre code)) {
    background-color: #111;
    color: var(--accent-color);
    padding: 0.15rem 0.35rem;
    border-radius: 2px;
    font-size: 0.88em;
    border: 1px solid #222;
  }

  /* Shiki inlines its own background-color on <pre>; override with !important */
  :global(.doc-body pre) {
    background-color: #060606 !important;
    border: 1px solid var(--border-color);
    padding: 1.2rem;
    border-radius: 3px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  :global(.doc-body .table-container) {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  :global(.doc-body table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    border: 1px solid var(--border-color);
  }

  :global(.doc-body th) {
    background-color: #111;
    color: #fff;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-color);
    text-align: left;
  }

  :global(.doc-body td) {
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-color);
    color: #bbb;
  }

  :global(.doc-body tr:nth-child(even)) {
    background-color: #090909;
  }

  :global(.doc-body ul),
  :global(.doc-body ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: #ccc;
    line-height: 1.7;
  }

  :global(.doc-body li) {
    margin-bottom: 0.35rem;
  }
</style>
