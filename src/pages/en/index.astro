---
/**
 * English Landing Page Hub / Linktree
 */
import WeeklyStats from '../../components/WeeklyStats.astro';
import MatrixBg from '../../components/MatrixBg.astro';
import LayoutGlobal from '../../layouts/LayoutGlobal.astro';
import '../global-style.css';

const externalLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/bagi-sh',
    icon: '/icons/github.svg',
  },
  {
  name: 'Last.fm',
    url: 'https://www.last.fm/user/nerokkj',
    icon: '/icons/lastfm.svg',
  },
  {
    name: 'Email',
    url: 'mailto:bagi.aq@proton.me',
    icon: '/icons/email.svg',
  },
];
---

<LayoutGlobal title="Bagi-sh | Low-Level Programming, Software Archtiture & Security" lang="en">
<MatrixBg/>
<section class="hero-section scroll-reveal">
  <div class="avatar-container">
    <img src="/icons/avatar.png" alt="BAGI" class="profile-avatar" />
  </div>
  <div class="hero-bio">
    <h1 class="username">BAGI</h1>
    <span class="handle">@bagi-sh</span>
    <p class="description">
      Low-level Programming, Cybersecurity & Software Archtiture.
    </p>
  </div>
</section>
   <!-- why have sm ways to comment in html? -->

  <section class="hub-nav-section scroll-reveal">
    <div class="section-desc">
      <h2 class="section-title">Navigation Hub</h2>
      <p>
        Internal documentation, project logs, low-level technical notes, and microblog posts.
      </p>
    </div>

    <div class="cards-group">
      <a href="/en/feed/" class="hub-card">
        <div class="card-left">
          <img src="/icons/feed.svg" alt="Feed" class="card-icon" />
          <span>Microblog Feed</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
      <a href="/en/projetos/project-alpha/" class="hub-card">
        <div class="card-left">
          <img src="/icons/folder.svg" alt="Projects" class="card-icon" />
          <span>Projects Portfolio</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
      <a href="/en/docs/example-doc/" class="hub-card">
        <div class="card-left">
          <img src="/icons/book.svg" alt="Docs" class="card-icon" />
          <span>Technical Documentation</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
    </div>
  </section>
  <!-- Section C: Social & Contact Links -->
<section class="external-links-section scroll-reveal">
    <div class="cards-group">
      {externalLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="external-link-card">
          <div class="card-left">
            <img src={link.icon} alt={link.name} class="card-icon" />
            <span>{link.name}</span>
          </div>
          <span class="ext-icon">&#8599;</span>
        </a>
      ))}
    </div>

    <div class="section-desc">
      <h2 class="section-title">Connect &amp; Socials</h2>
      <p>
        Public profiles, GitHub repositories, Last.fm scrobbles, and direct communication channels.
      </p>
    </div>
  </section>
  <WeeklyStats/>
