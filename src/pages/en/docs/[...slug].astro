---
import { projects } from '../../../data/projects';
import { getProjectDocs } from '../../../lib/github-docs';

export async function getStaticPaths() {
  const paths = [];

  for (const project of projects) {
    if (!project.docs) continue;
    const projectDocs = await getProjectDocs(project);

    for (const doc of projectDocs.flatDocs) {
      const slugParts = [project.slug];
      if (doc.slug) {
        slugParts.push(...doc.slug.split('/'));
      }

      paths.push({
        params: {
          slug: slugParts.join('/'),
        },
        props: {
          targetUrl: doc.fullSlug,
        },
      });
    }
  }

  return paths;
}

interface Props {
  targetUrl: string;
}

const { targetUrl } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
    <title>Redirecting to Documentation | Bagi-sh</title>
  </head>
  <body>
    <p>Redirecting to <a href={targetUrl}>{targetUrl}</a>...</p>
  </body>
</html>
