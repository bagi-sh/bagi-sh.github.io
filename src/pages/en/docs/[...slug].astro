---
/**
 * English Docs Route with Accordion Navigation
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import LayoutGlobal from '../../../layouts/LayoutGlobal.astro';
import '../../global-style.css';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const enDocs = docs.filter(d => d.slug.startsWith('en/'));

  return enDocs.map(entry => ({
    params: { slug: entry.slug.replace(/^en\//, '') },
    props: { entry, allDocs: enDocs },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
  allDocs: CollectionEntry<'docs'>[];
}

const { entry, allDocs } = Astro.props;
const { Content } = await entry.render();

const currentSlug = entry.slug.replace(/^en\//, '');
const switchedPath = currentSlug === 'example-doc' ? '/pt/docs/exemplo-doc/' : `/pt/docs/${currentSlug}/`;

// Sort docs by order if available
const sortedDocs = [...allDocs].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<LayoutGlobal title={`${entry.data.title} | Docs`} description={entry.data.description} lang="en" switchedPath={switchedPath}>
  <div class="docs-container">
    <aside class="docs-accordion-sidebar">
      <h3>
        <img src="/icons/book.svg" alt="Docs Icon" class="card-icon" />
        Documentation
      </h3>

      <details class="accordion-group" open>
        <summary class="accordion-summary">
          <span>Topics & Articles</span>
          <img src="/icons/chevron-right.svg" alt="Toggle" class="accordion-icon" />
        </summary>
        <ul class="accordion-item-list">
          {sortedDocs.map(d => {
            const slugPath = d.slug.replace(/^en\//, '');
            const isActive = slugPath === currentSlug;
            return (
              <li>
                <a href={`/en/docs/${slugPath}/`} class={isActive ? 'active' : ''}>
                  <img src="/icons/file-text.svg" alt="Doc" style="width:14px; height:14px;" />
                  <span>{d.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    </aside>

    <article class="doc-content">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <Content />
    </article>
  </div>
</LayoutGlobal>
