---
/**
 * Portuguese Landing Page Hub / Linktree
 */
import LayoutGlobal from '../../layouts/LayoutGlobal.astro';
import '../global-style.css';

const externalLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/bagi-sh',
    icon: '/icons/github.svg',
  },
  {
    name: 'Last.fm',
    url: 'https://www.last.fm/user/nerokkj',
    icon: '/icons/lastfm.svg',
  },
  {
    name: 'E-mail',
    url: 'mailto:bagi.aq@proton.me',
    icon: '/icons/email.svg',
  },
];
---

<LayoutGlobal title="Bagi-sh.com | Engenharia & Cibersegurança" lang="pt">
  <div class="hub-container">
    <!-- Seção A: Perfil (Header) -->
    <header class="profile-header">
      <img src="/icons/avatar.png" alt="Avatar de Bagi" class="avatar-img" />
      <div>
        <h1>Bagi</h1>
        <p class="handle">@bagi-sh</p>
      </div>
      <p class="bio">
      Programação baixo nível, Cibersegurança e Arquitetura de Software
      </p>
    </header>

    <!-- Seção B: Navegação Interna (Hub) -->
    <section class="hub-nav-section">
      <h2 class="section-title">Navegação Interna</h2>
      <a href="/pt/feed/" class="hub-card">
        <div class="card-left">
          <img src="../icons/feed.svg" alt="Feed" class="card-icon" />
          <span>Microblog (Feed)</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
      <a href="/pt/projetos/projeto-alpha/" class="hub-card">
        <div class="card-left">
          <img src="../icons/folder.svg" alt="Projetos" class="card-icon" />
          <span>Portfólio de Projetos</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
      <a href="/pt/docs/exemplo-doc/" class="hub-card">
        <div class="card-left">
          <img src="../icons/book.svg" alt="Docs" class="card-icon" />
          <span>Documentação Técnica</span>
        </div>
        <span class="ext-icon">&rarr;</span>
      </a>
    </section>

    <!-- Seção C: Contatos e Redes (Links Externos) -->
    <section class="external-links-section">
      <h2 class="section-title">Contatos e Redes</h2>
      {externalLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="external-link-card">
          <div class="card-left">
            <img src={link.icon} alt={link.name} class="card-icon" />
            <span>{link.name}</span>
          </div>
          <span class="ext-icon">&#8599;</span>
        </a>
      ))}
    </section>
  </div>
</LayoutGlobal>
