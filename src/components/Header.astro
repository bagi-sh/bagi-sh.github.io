---
/**
 * Header Component
 * Renders branding and navigation links with dynamic language toggle.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  switchedPath?: string;
}

const { lang, switchedPath: customSwitchedPath } = Astro.props;
const t = useTranslations(lang);

const targetLang: Lang = lang === 'pt' ? 'en' : 'pt';
const targetLabel = lang === 'pt' ? 'EN' : 'PT';

const apiKey = import.meta.env.PUBLIC_LASTFM_API_KEY;
const usernameFm = import.meta.env.PUBLIC_LASTFM_USERNAME;

// Correct path per language
const projectPath = lang === 'pt' ? '/pt/projetos/projeto-alpha/' : '/en/projetos/project-alpha/';
const docPath = lang === 'pt' ? '/pt/docs/exemplo-doc/' : '/en/docs/example-doc/';

// Smart language switch calculation
let switchedPath = customSwitchedPath;

if (!switchedPath) {
  const currentPath = Astro.url.pathname;
  
  const routeMap: Record<string, string> = {
    '/pt/': '/en/',
    '/en/': '/pt/',
    '/pt/feed/': '/en/feed/',
    '/en/feed/': '/pt/feed/',
    '/pt/projetos/projeto-alpha/': '/en/projetos/project-alpha/',
    '/en/projetos/project-alpha/': '/pt/projetos/projeto-alpha/',
    '/pt/docs/exemplo-doc/': '/en/docs/example-doc/',
    '/en/docs/example-doc/': '/pt/docs/exemplo-doc/',
  };

  const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

  if (routeMap[normalizedPath]) {
    switchedPath = routeMap[normalizedPath];
  } else if (normalizedPath.includes(`/${lang}/`)) {
    switchedPath = normalizedPath.replace(`/${lang}/`, `/${targetLang}/`);
  } else {
    switchedPath = `/${targetLang}/`;
  }
}
---

<header class="site-header">
<script>
  let clickCount = 0;
  let resetTimer: ReturnType<typeof setTimeout>;

  const logo = document.querySelector('.lastfm-container');

  logo?.addEventListener('click', (e) => {
    clickCount++;
    
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => { clickCount = 0; }, 2000);

    if (clickCount === 5) {
      e.preventDefault();
      // adicionar um "estado". caso a pessoa veja a mensagem, ela possa eventualmente
      // usar o sudo no terminal d0 404 page
      alert("Why are you click in here? Ok, so I you give you Sudo access for this");
      clickCount = 0;
    }
  });
</script>
  <div class="header-container">
    <div class="header-left">
      <a href={`/${lang}/`} class="site-logo"> Bagi-sh</a>
      <div 
        id="lastfm-widget" 
        class="lastfm-container" 
        data-api-key={apiKey} 
        data-username={usernameFm}
      >
       <span class="music-icon">♫</span>
       <span id="lastfm-track" class="track-info">listening to nothing...</span>
      </div>
    </div>
    
    <nav class="site-nav">
      <a href={`/${lang}/`}>{t('nav.home')}</a>
      <a href={`/${lang}/feed/`}>{t('nav.feed')}</a>
      <a href={projectPath}>{t('nav.projects')}</a>
      <a href={docPath}>{t('nav.docs')}</a>
      <a href={switchedPath} class="lang-switch">{targetLabel}</a>
    </nav>
  </div>
</header>

<script>
  import { getNowPlaying } from '../lib/lastfm';

  async function updateWidget(): Promise<void> {
    const container = document.getElementById('lastfm-widget');
    const trackElement = document.getElementById('lastfm-track');

    if (!container || !trackElement) return;

    const apiKey = container.dataset.apiKey || '';
    const username = container.dataset.username || '';

    const data = await getNowPlaying(username, apiKey);

    if (!data) {
      trackElement.textContent = 'offline';
      container.classList.remove('is-playing');
      return;
    }

    trackElement.textContent = data.isPlaying ? `▶ ${data.text}` : `[last] ${data.text}`;
    trackElement.setAttribute('title', `${data.text} (${data.isPlaying ? 'Now Playing' : 'Last Played'})`);

    if (data.isPlaying) {
      container.classList.add('is-playing');
    } else {
      container.classList.remove('is-playing');
    }
  }

  updateWidget();
  setInterval(updateWidget, 30000);
</script>
