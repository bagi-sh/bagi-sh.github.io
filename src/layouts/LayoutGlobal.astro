---
/**
 * Global Layout Wrapper
 * Pure HTML5 boilerplate, 0 client-side JS overhead.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  switchedPath?: string;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const {
  title = 'Bagi-sh.com',
  description = 'Blog e portifolio.',
  switchedPath,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={currentLang} switchedPath={switchedPath} />
    <main class="content-container">
      <slot />
    </main>
    <Footer lang={currentLang} />
  </body>
</html>
