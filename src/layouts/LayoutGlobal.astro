---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, type Lang } from '../i18n/ui';
import '../styles/global.css';
import KonamiEasteregg from '../components/KonamiEasteregg.astro'

 interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  switchedPath?: string;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const {
  title = 'Bagi-sh',
  description = 'Blog e portifolio.',
  switchedPath,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <KonamiEasteregg/>
  <body>
    <Header lang={currentLang} switchedPath={switchedPath} />
    <main class="content-container">
      <slot />
    </main>
  <script>
    const asciiArt = `
     /\_/\\
    ( o.o )
     > ^ <   [Bagi-sh.com]
  `;
  
  console.log(
    `%c${asciiArt}\n%cBe welcome. Looking for vulnerabilities or just browsing?`,
    "color: #00ff66; font-family: monospace; font-weight: bold;",
    "color: #cccccc; font-family: monospace;"
  );

  (window as any).secret = function() {
    console.log("%c[+] UNLOCKED: YOU JUST FOUND A SECRET AND YOUR PRIZE IS ABSOLUT NOTHING!! CONGRATS.", "color: #00ff66; font-family: monospace;");
  };
</script>
    <Footer lang={currentLang} />
  </body>
</html>
